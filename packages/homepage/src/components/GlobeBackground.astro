---
// Full-viewport 3D globe showing private clients connecting to a public Proxer endpoint.
// Uses cobe v2 (WebGL).
---

<div class="globe-section" id="globe-section">
  <canvas id="globe-canvas"></canvas>
</div>

<script>
  import createGlobe from "cobe";

  function initGlobe() {
    const canvas = document.getElementById("globe-canvas") as HTMLCanvasElement;
    if (!canvas) return;

    const container = document.getElementById("globe-section")!;
    let phi = 0;
    let globe: ReturnType<typeof createGlobe> | null = null;
    let frameId: number | null = null;

    const clients: [number, number][] = [
      [37.56, 126.97],
      [35.68, 139.69],
      [37.77, -122.42],
      [51.51, -0.13],
      [52.52, 13.41],
      [-33.87, 151.21],
      [1.35, 103.82],
      [49.28, -123.12],
    ];

    const publicServer: [number, number] = [30, -30];
    const blue: [number, number, number] = [0.25, 0.55, 1];
    const cyan: [number, number, number] = [0.22, 0.74, 0.97];
    const indigo: [number, number, number] = [0.5, 0.45, 1];
    const colors = [blue, cyan, indigo];

    const arcs = clients.flatMap((client, i) => [
      { from: client, to: publicServer, color: colors[i % 3] },
      { from: publicServer, to: client, color: colors[(i + 1) % 3] },
    ]);

    function setup() {
      if (frameId != null) cancelAnimationFrame(frameId);
      if (globe) globe.destroy();

      const rect = container.getBoundingClientRect();
      const size = Math.max(rect.width, rect.height, 700);
      const dpr = Math.min(window.devicePixelRatio, 2);

      canvas.width = Math.round(size * dpr);
      canvas.height = Math.round(size * dpr);
      canvas.style.width = `${size}px`;
      canvas.style.height = `${size}px`;

      const isDark = document.documentElement.getAttribute("data-theme") !== "light";

      globe = createGlobe(canvas, {
        devicePixelRatio: dpr,
        width: size * dpr,
        height: size * dpr,
        phi,
        theta: 0.15,
        dark: isDark ? 1 : 0,
        diffuse: isDark ? 1.4 : 1.8,
        mapSamples: 20000,
        mapBrightness: isDark ? 3 : 6,
        baseColor: isDark ? [0.08, 0.1, 0.16] : [0.88, 0.91, 0.96],
        markerColor: [0.25, 0.55, 1],
        glowColor: isDark ? [0.04, 0.08, 0.18] : [0.82, 0.9, 1],
        markers: [
          { location: publicServer, size: 0.15 },
          ...clients.map((location) => ({ location, size: 0.04 })),
        ],
        arcs,
        arcColor: blue,
        arcWidth: 0.5,
        arcHeight: 0.3,
        scale: 1.1,
        offset: [0, 0],
        opacity: isDark ? 0.95 : 0.9,
      });

      function animate() {
        phi += 0.002;
        globe?.update({ phi });
        frameId = requestAnimationFrame(animate);
      }
      animate();
    }

    setup();

    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(setup, 250);
    });

    const observer = new MutationObserver((mutations) => {
      for (const mutation of mutations) {
        if (mutation.attributeName === "data-theme") {
          setup();
          break;
        }
      }
    });
    observer.observe(document.documentElement, { attributes: true });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGlobe);
  } else {
    initGlobe();
  }
</script>

<style>
  .globe-section {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  #globe-canvas {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.55;
    max-width: none;
    animation: globe-fadein 1.5s ease-out;
  }

  :global([data-theme="light"]) #globe-canvas {
    opacity: 0.35;
  }

  @keyframes globe-fadein {
    from { opacity: 0; transform: translate(-50%, -50%) scale(0.95); }
  }
</style>
