{
  "name": "@tinyrack/proxer",
  "version": "0.1.0",
  "description": "A reverse-tunnel CLI for Tinyrack.",
  "type": "module",
  "license": "MIT",
  "author": "winetree94",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tinyrack-net/proxer.git"
  },
  "homepage": "https://github.com/tinyrack-net/proxer#readme",
  "bugs": {
    "url": "https://github.com/tinyrack-net/proxer/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "tunnel",
    "reverse-tunnel",
    "proxer"
  ],
  "imports": {
    "#app/*.ts": {
      "@proxer/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "proxer": "./bin/index.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pkg:build": "proxer-tools pkg build",
    "pkg:smoke": "proxer-tools pkg smoke",
    "start": "node dist/index.js",
    "prepack": "pnpm run build",
    "pretest": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && biome check . && pnpm run test",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "release:patch": "proxer-tools release patch",
    "release:minor": "proxer-tools release minor",
    "release:major": "proxer-tools release major"
  },
  "devDependencies": {
    "@tinyrack/proxer-tools": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@stricli/core": "^1.2.7",
    "ws": "^8.20.1"
  }
}
